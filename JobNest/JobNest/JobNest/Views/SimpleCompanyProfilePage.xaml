<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="JobNest.Views.SimpleCompanyProfilePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Profil kompanije"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <StackLayout Spacing="0" Padding="0">

            <!-- Header -->
            <Grid BackgroundColor="#1B5E20" HeightRequest="60">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" 
                        Text="←" 
                        BackgroundColor="Transparent" 
                        TextColor="White" 
                        FontSize="24"
                        Clicked="OnBackClicked"/>

                <Label Grid.Column="1" 
                       Text="Profil kompanije" 
                       TextColor="White" 
                       FontSize="18" 
                       FontAttributes="Bold" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center"/>
            </Grid>

            <!-- Company Info -->
            <StackLayout BackgroundColor="White" Padding="20" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Company Logo -->
                    <Frame Grid.Column="0" 
                           BackgroundColor="#E8F5E8" 
                           CornerRadius="40" 
                           Padding="15" 
                           HeightRequest="80" 
                           WidthRequest="80"
                           HasShadow="False">
                        <Label Text="🏢" 
                               FontSize="40" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center"/>
                    </Frame>

                    <!-- Company Name and Info -->
                    <StackLayout Grid.Column="1" 
                                 Spacing="5" 
                                 Margin="15,0,0,0" 
                                 VerticalOptions="Center">
                        <Label x:Name="CompanyNameLabel" 
                               Text="Naziv kompanije" 
                               FontSize="20" 
                               FontAttributes="Bold" 
                               TextColor="#1B5E20"/>
                        <Label Text="IT kompanija" 
                               FontSize="14" 
                               TextColor="Gray"/>
                        <StackLayout Orientation="Horizontal" Spacing="5">
                            <Label Text="📍" FontSize="12"/>
                            <Label Text="Sarajevo, BiH" 
                                   FontSize="12" 
                                   TextColor="Gray"/>
                        </StackLayout>
                    </StackLayout>
                </Grid>
            </StackLayout>

            <!-- Stats -->
            <Grid BackgroundColor="White" Padding="20" Margin="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackLayout Grid.Column="0" HorizontalOptions="Center">
                    <Label x:Name="ActiveJobsCountLabel" 
                           Text="5" 
                           FontSize="24" 
                           FontAttributes="Bold" 
                           TextColor="#1B5E20" 
                           HorizontalOptions="Center"/>
                    <Label Text="Aktivni poslovi" 
                           FontSize="12" 
                           TextColor="Gray" 
                           HorizontalOptions="Center"/>
                </StackLayout>

                <StackLayout Grid.Column="1" HorizontalOptions="Center">
                    <Label x:Name="TotalApplicationsLabel" 
                           Text="23" 
                           FontSize="24" 
                           FontAttributes="Bold" 
                           TextColor="#1B5E20" 
                           HorizontalOptions="Center"/>
                    <Label Text="Ukupno aplikacija" 
                           FontSize="12" 
                           TextColor="Gray" 
                           HorizontalOptions="Center"/>
                </StackLayout>

                <StackLayout Grid.Column="2" HorizontalOptions="Center">
                    <Label Text="50-100" 
                           FontSize="24" 
                           FontAttributes="Bold" 
                           TextColor="#1B5E20" 
                           HorizontalOptions="Center"/>
                    <Label Text="Zaposlenih" 
                           FontSize="12" 
                           TextColor="Gray" 
                           HorizontalOptions="Center"/>
                </StackLayout>
            </Grid>

            <!-- Contact Information -->
            <StackLayout BackgroundColor="White" Padding="20" Margin="0,10,0,0">
                <Label Text="Kontakt informacije" 
                       FontSize="16" 
                       FontAttributes="Bold" 
                       TextColor="#1B5E20" 
                       Margin="0,0,0,15"/>

                <!-- Email -->
                <StackLayout Orientation="Horizontal" Spacing="15" Margin="0,5">
                    <Label Text="📧" FontSize="18"/>
                    <StackLayout>
                        <Label Text="Email adresa" FontSize="12" TextColor="Gray"/>
                        <Label x:Name="EmailLabel" 
                               Text="info@kompanija.ba" 
                               FontSize="14" 
                               TextColor="#333"/>
                    </StackLayout>
                </StackLayout>

                <!-- Phone -->
                <StackLayout Orientation="Horizontal" Spacing="15" Margin="0,15,0,5">
                    <Label Text="📞" FontSize="18"/>
                    <StackLayout>
                        <Label Text="Telefon" FontSize="12" TextColor="Gray"/>
                        <Label Text="+387 33 123 456" 
                               FontSize="14" 
                               TextColor="#333"/>
                    </StackLayout>
                </StackLayout>

                <!-- Website -->
                <StackLayout Orientation="Horizontal" Spacing="15" Margin="0,15,0,5">
                    <Label Text="🌐" FontSize="18"/>
                    <StackLayout>
                        <Label Text="Website" FontSize="12" TextColor="Gray"/>
                        <Label Text="www.kompanija.ba" 
                               FontSize="14" 
                               TextColor="#1B5E20" 
                               TextDecorations="Underline"/>
                    </StackLayout>
                </StackLayout>
            </StackLayout>

            <!-- Action Buttons -->
            <StackLayout Padding="20" Spacing="15" Margin="0,10,0,20">
                <Button Text="UREDI PROFIL KOMPANIJE"
                        BackgroundColor="#1B5E20"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        CornerRadius="25"
                        Clicked="OnEditProfileClicked"/>

                <Button Text="POSTAVKE"
                        BackgroundColor="Transparent"
                        TextColor="#1B5E20"
                        FontSize="14"
                        HeightRequest="45"
                        BorderColor="#1B5E20"
                        BorderWidth="1"
                        CornerRadius="22"
                        Clicked="OnSettingsClicked"/>
            </StackLayout>

        </StackLayout>
    </ScrollView>
</ContentPage>