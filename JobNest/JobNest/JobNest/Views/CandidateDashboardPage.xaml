<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="JobNest.Views.CandidateDashboardPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F8F9FA">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" BackgroundColor="#1B5E20" Padding="20,50,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackLayout Grid.Column="0">
                <Label x:Name="GreetingLabel"
                       Text="Dobro jutro" 
                       FontSize="16" 
                       TextColor="White" 
                       Opacity="0.8"/>
                <Label x:Name="NameLabel"
                       Text="Ime i prezime"
                       FontSize="24" 
                       FontAttributes="Bold"
                       TextColor="White"/>
            </StackLayout>

            <Frame Grid.Column="1" 
                   WidthRequest="50" 
                   HeightRequest="50" 
                   CornerRadius="25" 
                   BackgroundColor="White" 
                   Padding="0">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnProfileTapped" />
                </Frame.GestureRecognizers>
                <Label Text="👤" 
                       FontSize="24" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center"/>
            </Frame>
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1" Padding="20">
            <StackLayout Spacing="25">

                <!-- Search Bar -->
                <Frame BackgroundColor="White" CornerRadius="25" Padding="15,10" HasShadow="True">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSearchBarTapped" />
                    </Frame.GestureRecognizers>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" Text="🔍" FontSize="18" VerticalOptions="Center" Margin="5,0"/>
                        <Label Grid.Column="1" 
                               Text="Traži posao ovdje" 
                               TextColor="Gray"
                               FontSize="16"
                               VerticalOptions="Center"/>
                    </Grid>
                </Frame>

                <!-- Recommended Jobs Section -->
                <StackLayout Spacing="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" 
                               Text="Preporučeni poslovi" 
                               FontSize="20" 
                               FontAttributes="Bold" 
                               TextColor="#1B5E20"/>
                        <Label Grid.Column="1" 
                               Text="More" 
                               FontSize="14" 
                               TextColor="#1B5E20" 
                               VerticalOptions="Center"/>
                    </Grid>

                    <!-- Job Card 1 -->
                    <Frame BackgroundColor="White" CornerRadius="15" Padding="20" HasShadow="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Company Logo -->
                            <Frame Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                                   WidthRequest="50" HeightRequest="50" 
                                   CornerRadius="25" BackgroundColor="#E8F5E8" 
                                   Padding="0" Margin="0,0,15,0">
                                <Label Text="💼" FontSize="24" 
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Frame>

                            <!-- Job Title -->
                            <Label Grid.Row="0" Grid.Column="1" 
                                   Text="Software Engineer" 
                                   FontSize="18" 
                                   FontAttributes="Bold" 
                                   TextColor="Black"/>

                            <!-- Company Name -->
                            <Label Grid.Row="1" Grid.Column="1" 
                                   Text="Sarajevo, BiH" 
                                   FontSize="14" 
                                   TextColor="Gray"/>

                            <!-- Salary -->
                            <StackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                                         Orientation="Horizontal" 
                                         Margin="0,10,0,0">
                                <Label Text="💰" FontSize="14"/>
                                <Label Text="1500 KM - 2500 KM" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="#1B5E20"/>
                            </StackLayout>
                        </Grid>
                    </Frame>

                </StackLayout>

                <!-- Recent Jobs Section -->
                <StackLayout Spacing="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" 
                               Text="Recent Jobs" 
                               FontSize="20" 
                               FontAttributes="Bold" 
                               TextColor="#1B5E20"/>
                        <Label Grid.Column="1" 
                               Text="More" 
                               FontSize="14" 
                               TextColor="#1B5E20" 
                               VerticalOptions="Center"/>
                    </Grid>

                    <!-- Recent Jobs List -->
                    <CollectionView x:Name="RecentJobsCollectionView" HeightRequest="300">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,5">
                                    <Frame BackgroundColor="White" CornerRadius="10" Padding="15" HasShadow="True">
                                        <StackLayout Orientation="Horizontal" Spacing="15">
                                            <!-- Company Logo -->
                                            <Frame WidthRequest="40" HeightRequest="40" 
                                                   CornerRadius="20" BackgroundColor="#E8F5E8" 
                                                   Padding="0">
                                                <Label Text="🏢" FontSize="20" 
                                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                                            </Frame>

                                            <!-- Job Info -->
                                            <StackLayout VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                                                <Label Text="{Binding Title}" 
                                                       FontSize="16" 
                                                       FontAttributes="Bold" 
                                                       TextColor="Black"/>
                                                <Label Text="{Binding Location}" 
                                                       FontSize="12" 
                                                       TextColor="Gray"/>
                                                <Label Text="{Binding Salary}" 
                                                       FontSize="12" 
                                                       TextColor="#1B5E20"/>
                                            </StackLayout>
                                        </StackLayout>
                                    </Frame>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </StackLayout>

            </StackLayout>
        </ScrollView>

        <!-- Bottom Navigation -->
        <Grid Grid.Row="2" BackgroundColor="White" Padding="10,15" HeightRequest="80">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackLayout Grid.Column="0" Spacing="5">
                <Label Text="🏠" FontSize="20" HorizontalOptions="Center" TextColor="#1B5E20"/>
                <Label Text="Početna" FontSize="12" HorizontalOptions="Center" TextColor="#1B5E20"/>
            </StackLayout>

            <StackLayout Grid.Column="1" Spacing="5">
                <Label Text="📋" FontSize="20" HorizontalOptions="Center" TextColor="Gray"/>
                <Label Text="Listinzi" FontSize="12" HorizontalOptions="Center" TextColor="Gray"/>
            </StackLayout>

            <StackLayout Grid.Column="2" Spacing="5">
                <Label Text="💬" FontSize="20" HorizontalOptions="Center" TextColor="Gray"/>
                <Label Text="Poruke" FontSize="12" HorizontalOptions="Center" TextColor="Gray"/>
            </StackLayout>

            <StackLayout Grid.Column="3" Spacing="5">
                <Label Text="👤" FontSize="20" HorizontalOptions="Center" TextColor="Gray"/>
                <Label Text="Račun" FontSize="12" HorizontalOptions="Center" TextColor="Gray"/>
            </StackLayout>
        </Grid>

    </Grid>
</ContentPage>