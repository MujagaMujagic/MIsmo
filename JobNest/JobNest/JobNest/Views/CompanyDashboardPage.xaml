<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="JobNest.Views.CompanyDashboardPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F8F9FA">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" BackgroundColor="#1B5E20" Padding="20,50,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackLayout Grid.Column="0">
                <Label x:Name="GreetingLabel"
                       Text="Dobro jutro" 
                       FontSize="16" 
                       TextColor="White" 
                       Opacity="0.8"/>
                <Label x:Name="CompanyNameLabel"
                       Text="Naziv kompanije"
                       FontSize="24" 
                       FontAttributes="Bold"
                       TextColor="White"/>
            </StackLayout>

            <Frame Grid.Column="1" 
                   WidthRequest="50" 
                   HeightRequest="50" 
                   CornerRadius="25" 
                   BackgroundColor="White" 
                   Padding="0">
                <Label Text="🏢" 
                       FontSize="24" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center"/>
            </Frame>
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1" Padding="20">
            <StackLayout Spacing="25">

                <!-- Quick Stats -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Frame Grid.Column="0" BackgroundColor="White" CornerRadius="15" Padding="20" HasShadow="True" Margin="0,0,10,0">
                        <StackLayout Spacing="10">
                            <Label Text="📋" FontSize="30" HorizontalOptions="Center"/>
                            <Label x:Name="ActiveJobsLabel" Text="0" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#1B5E20"/>
                            <Label Text="Aktivni poslovi" FontSize="14" HorizontalOptions="Center" TextColor="Gray"/>
                        </StackLayout>
                    </Frame>

                    <Frame Grid.Column="1" BackgroundColor="White" CornerRadius="15" Padding="20" HasShadow="True" Margin="10,0,0,0">
                        <StackLayout Spacing="10">
                            <Label Text="👥" FontSize="30" HorizontalOptions="Center"/>
                            <Label x:Name="ApplicationsLabel" Text="0" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#1B5E20"/>
                            <Label Text="Aplikacije" FontSize="14" HorizontalOptions="Center" TextColor="Gray"/>
                        </StackLayout>
                    </Frame>
                </Grid>

                <!-- Add Job Button -->
                <Button Text="+ OBJAVI NOVI POSAO"
                        BackgroundColor="#1B5E20"
                        TextColor="White"
                        CornerRadius="25"
                        HeightRequest="50"
                        FontSize="16"
                        FontAttributes="Bold"
                        Clicked="OnAddJobClicked"/>

                <!-- My Job Posts Section -->
                <StackLayout Spacing="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" 
                               Text="Moji oglasi" 
                               FontSize="20" 
                               FontAttributes="Bold" 
                               TextColor="#1B5E20"/>
                        <Label Grid.Column="1" 
                               Text="Svi" 
                               FontSize="14" 
                               TextColor="#1B5E20" 
                               VerticalOptions="Center"/>
                    </Grid>

                    <!-- Job Posts List -->
                    <CollectionView x:Name="MyJobsCollectionView" HeightRequest="400">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,5">
                                    <Frame BackgroundColor="White" CornerRadius="10" Padding="20" HasShadow="True">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Job Title -->
                                            <Label Grid.Row="0" 
                                                   Text="{Binding Title}" 
                                                   FontSize="18" 
                                                   FontAttributes="Bold" 
                                                   TextColor="Black"/>

                                            <!-- Location and Salary -->
                                            <Grid Grid.Row="1" Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackLayout Grid.Column="0" Orientation="Horizontal">
                                                    <Label Text="📍" FontSize="14"/>
                                                    <Label Text="{Binding Location}" FontSize="14" TextColor="Gray"/>
                                                </StackLayout>

                                                <StackLayout Grid.Column="1" Orientation="Horizontal" HorizontalOptions="End">
                                                    <Label Text="💰" FontSize="14"/>
                                                    <Label Text="{Binding SalaryMin, StringFormat='{0} - '}" FontSize="14" TextColor="#1B5E20" FontAttributes="Bold"/>
                                                    <Label Text="{Binding SalaryMax, StringFormat='{0} KM'}" FontSize="14" TextColor="#1B5E20" FontAttributes="Bold"/>
                                                </StackLayout>
                                            </Grid>

                                            <!-- Posted Date -->
                                            <Label Grid.Row="2" 
                                                   Text="{Binding PostedDate, StringFormat='Objavljeno: {0:dd.MM.yyyy}'}" 
                                                   FontSize="12" 
                                                   TextColor="Gray" 
                                                   Margin="0,5"/>

                                            <!-- Action Buttons -->
                                            <Grid Grid.Row="3" Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0" 
                                                        Text="UREDI" 
                                                        BackgroundColor="Transparent" 
                                                        TextColor="#1B5E20" 
                                                        BorderColor="#1B5E20" 
                                                        BorderWidth="1" 
                                                        CornerRadius="20" 
                                                        FontSize="11" 
                                                        Margin="0,0,3,0"
                                                        Clicked="OnEditJobClicked"
                                                        CommandParameter="{Binding .}"/>

                                                <Button Grid.Column="1" 
                                                        Text="OBRIŠI" 
                                                        BackgroundColor="Transparent" 
                                                        TextColor="#D32F2F" 
                                                        BorderColor="#D32F2F" 
                                                        BorderWidth="1" 
                                                        CornerRadius="20" 
                                                        FontSize="11" 
                                                        Margin="3,0,3,0"
                                                        Clicked="OnDeleteJobClicked"
                                                        CommandParameter="{Binding .}"/>

                                                <Button Grid.Column="2" 
                                                        BackgroundColor="#1B5E20" 
                                                        TextColor="White" 
                                                        CornerRadius="20" 
                                                        FontSize="11" 
                                                        Margin="3,0,0,0"
                                                        Clicked="OnViewApplicationsClicked"
                                                        CommandParameter="{Binding .}">
                                                    <Button.Text>
                                                        <MultiBinding StringFormat="APLIKACIJE ({0})">
                                                            <Binding Path="ApplicationCount" />
                                                        </MultiBinding>
                                                    </Button.Text>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Frame>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </StackLayout>

            </StackLayout>
        </ScrollView>

        <!-- Bottom Navigation -->
        <Grid Grid.Row="2" BackgroundColor="White" Padding="10,15" HeightRequest="80">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackLayout Grid.Column="0" Spacing="5">
                <Label Text="🏠" FontSize="20" HorizontalOptions="Center" TextColor="#1B5E20"/>
                <Label Text="Početna" FontSize="12" HorizontalOptions="Center" TextColor="#1B5E20"/>
            </StackLayout>

            <StackLayout Grid.Column="1" Spacing="5">
                <Label Text="📋" FontSize="20" HorizontalOptions="Center" TextColor="Gray"/>
                <Label Text="Oglasi" FontSize="12" HorizontalOptions="Center" TextColor="Gray"/>
            </StackLayout>

            <StackLayout Grid.Column="2" Spacing="5">
                <Label Text="👥" FontSize="20" HorizontalOptions="Center" TextColor="Gray"/>
                <Label Text="Kandidati" FontSize="12" HorizontalOptions="Center" TextColor="Gray"/>
            </StackLayout>

            <StackLayout Grid.Column="3" Spacing="5">
                <Label Text="⚙️" FontSize="20" HorizontalOptions="Center" TextColor="Gray"/>
                <Label Text="Postavke" FontSize="12" HorizontalOptions="Center" TextColor="Gray"/>
            </StackLayout>
        </Grid>

    </Grid>
</ContentPage>