<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="JobNest.Views.UserTypeSelectionPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="White">

    <StackLayout Padding="40,60,40,40" Spacing="40">

        <!-- Header -->
        <StackLayout Spacing="15" HorizontalOptions="Center">
            <Frame BackgroundColor="#1B5E20" 
                   CornerRadius="40"
                   WidthRequest="80"
                   HeightRequest="80"
                   HorizontalOptions="Center">
                <Label Text="🚀" 
                       FontSize="40"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Frame>

            <Label Text="CLIMB HIGHER WITH"
                   FontSize="16"
                   TextColor="Gray"
                   HorizontalOptions="Center"/>

            <Label Text="JobNest app"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="Black"
                   HorizontalOptions="Center"/>
        </StackLayout>

        <Label Text="Nastavi kao"
               FontSize="20"
               FontAttributes="Bold"
               TextColor="Black"
               HorizontalOptions="Center"/>

        <!-- User Type Cards -->
        <StackLayout Spacing="20">

            <!-- Candidate Card -->
            <Frame BackgroundColor="#F5F5F5"
                   CornerRadius="15"
                   Padding="20"
                   HasShadow="True">
                <StackLayout Orientation="Horizontal" Spacing="15">
                    <Frame BackgroundColor="#E3F2FD" 
                           CornerRadius="25"
                           WidthRequest="50"
                           HeightRequest="50"
                           Padding="0">
                        <Label Text="👨‍💼" 
                               FontSize="24"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Frame>
                    <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="Center">
                        <Label Text="TRAŽITELJI POSLA"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#1B5E20"/>
                        <Label Text="Pronađi poslove koje odgovaraju tvojim sposobnostima"
                               FontSize="12"
                               TextColor="Gray"/>
                    </StackLayout>
                </StackLayout>
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCandidateSelected"/>
                </Frame.GestureRecognizers>
            </Frame>

            <!-- Company Card -->
            <Frame BackgroundColor="#F5F5F5"
                   CornerRadius="15"
                   Padding="20"
                   HasShadow="True">
                <StackLayout Orientation="Horizontal" Spacing="15">
                    <Frame BackgroundColor="#FFF3E0" 
                           CornerRadius="25"
                           WidthRequest="50"
                           HeightRequest="50"
                           Padding="0">
                        <Label Text="🏢" 
                               FontSize="24"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Frame>
                    <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="Center">
                        <Label Text="KOMPANIJA"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#1B5E20"/>
                        <Label Text="Pronađi idealnog kandidata za vašu kompaniju"
                               FontSize="12"
                               TextColor="Gray"/>
                    </StackLayout>
                </StackLayout>
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCompanySelected"/>
                </Frame.GestureRecognizers>
            </Frame>

        </StackLayout>
    </StackLayout>
</ContentPage>