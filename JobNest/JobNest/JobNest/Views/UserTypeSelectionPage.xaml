<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="JobNest.Views.UserTypeSelectionPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="White">

    <ScrollView>
        <StackLayout Padding="40,60,40,40" Spacing="35">

            <!-- Header -->
            <StackLayout Spacing="15" HorizontalOptions="Center">
                <!-- Planinar ilustracija -->
                <Image Source="mountain1.png"
                       WidthRequest="300"
                       HeightRequest="300"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>

              
            </StackLayout>

            <Label Text="Nastavi kao"
                   FontSize="30"
                   FontAttributes="Bold"
                   TextColor="Black"
                   HorizontalOptions="Center"/>

            <Label Text="Bilo da tražiš svoj sljedeći posao ili idealnog kandidata — odaberi svoj put ispod."
                   FontSize="14"
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"/>

            <!-- User Type Cards -->
            <StackLayout Spacing="20">

                <!-- Candidate Card -->
                <Frame BackgroundColor="White"
                       CornerRadius="15"
                       Padding="15"
                       HasShadow="True">
                    <StackLayout Orientation="Horizontal" Spacing="15">
                        <Image Source="jobseeker.png"
                               WidthRequest="50"
                               HeightRequest="50"
                               VerticalOptions="Center"/>
                        <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="Center">
                            <Label Text="TRAŽITELJI POSLA"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#1B5E20"/>
                            <Label Text="Pronalaženje posla ovdje nikada nije bilo lakše nego prije"
                                   FontSize="12"
                                   TextColor="Black"/>
                        </StackLayout>
                    </StackLayout>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCandidateSelected"/>
                    </Frame.GestureRecognizers>
                </Frame>

                <!-- Company Card -->
                <Frame BackgroundColor="White"
                       CornerRadius="15"
                       Padding="15"
                       HasShadow="True">
                    <StackLayout Orientation="Horizontal" Spacing="15">
                        <Image Source="employer.png"
                               WidthRequest="50"
                               HeightRequest="50"
                               VerticalOptions="Center"/>
                        <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="Center">
                            <Label Text="KOMPANIJA"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#1B5E20"/>
                            <Label Text="Hajde da brže pronađemo tvog idealnog kandidata ovdje"
                                   FontSize="12"
                                   TextColor="Black"/>
                        </StackLayout>
                    </StackLayout>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCompanySelected"/>
                    </Frame.GestureRecognizers>
                </Frame>

            </StackLayout>
        </StackLayout>
    </ScrollView>
</ContentPage>
