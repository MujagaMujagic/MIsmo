<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="JobNest.Views.SimpleJobDetailPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Detalji posla"
             BackgroundColor="#2E7D32">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackLayout Grid.Row="0" 
                     BackgroundColor="#2E7D32" 
                     Padding="20,50,20,20">

            <StackLayout Orientation="Horizontal" Spacing="15">
                <Button x:Name="BackButton"
                        Text="← Nazad"
                        BackgroundColor="White"
                        TextColor="#2E7D32"
                        CornerRadius="25"
                        Padding="10"
                        FontSize="16"
                        Clicked="OnBackClicked" />

                <Label Text="Detalji posla"
                       TextColor="White"
                       FontSize="20"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
            </StackLayout>

            <!-- Job Info -->
            <StackLayout Spacing="10" Margin="0,20,0,0">
                <Label x:Name="CompanyLabel"
                       Text="Kompanija"
                       TextColor="White"
                       FontSize="16" />
                <Label x:Name="TitleLabel"
                       Text="Naziv posla"
                       TextColor="White"
                       FontSize="20"
                       FontAttributes="Bold" />
            </StackLayout>

        </StackLayout>

        <!-- Content -->
        <ScrollView Grid.Row="1" BackgroundColor="White">
            <StackLayout Padding="20" Spacing="20">

                <!-- Salary -->
                <StackLayout Spacing="10">
                    <Label Text="💰 Plata"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#2E7D32" />
                    <Label x:Name="SalaryLabel"
                           Text="Plata"
                           FontSize="16"
                           TextColor="#333" />
                </StackLayout>

                <!-- Location -->
                <StackLayout Spacing="10">
                    <Label Text="📍 Lokacija"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#2E7D32" />
                    <Label x:Name="LocationLabel"
                           Text="Lokacija"
                           FontSize="16"
                           TextColor="#333" />
                </StackLayout>

                <!-- Description -->
                <StackLayout Spacing="10">
                    <Label Text="📋 Opis posla"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#2E7D32" />
                    <Label x:Name="DescriptionLabel"
                           Text="Opis posla"
                           FontSize="14"
                           TextColor="#333"
                           LineBreakMode="WordWrap" />
                </StackLayout>

            </StackLayout>
        </ScrollView>

        <!-- Apply Button -->
        <StackLayout Grid.Row="2" 
                     BackgroundColor="White" 
                     Padding="20">
            <Button x:Name="ApplyButton"
                    Text="APLICIRAJ ZA POSAO"
                    BackgroundColor="#2E7D32"
                    TextColor="White"
                    CornerRadius="25"
                    Padding="0,15"
                    FontSize="16"
                    FontAttributes="Bold"
                    Clicked="OnApplyClicked" />
        </StackLayout>

    </Grid>

</ContentPage>