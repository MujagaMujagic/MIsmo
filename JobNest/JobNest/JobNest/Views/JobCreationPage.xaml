<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="JobNest.Views.JobCreationPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Objavi novi posao"
             BackgroundColor="White">

    <ScrollView>
        <StackLayout Padding="20" Spacing="15">

            <!-- Header -->
            <StackLayout Orientation="Horizontal" Spacing="15">
                <Button x:Name="BackButton" 
                        Text="←" 
                        BackgroundColor="Transparent" 
                        TextColor="#4CAF50" 
                        FontSize="24"
                        WidthRequest="40"
                        HeightRequest="40"
                        Clicked="OnBackClicked"/>
                <Label Text="Objavi novi posao" 
                       FontSize="22" 
                       FontAttributes="Bold" 
                       TextColor="#2E7D32" 
                       VerticalOptions="Center"/>
            </StackLayout>

            <!-- Naziv pozicije -->
            <StackLayout>
                <Label Text="Naziv pozicije *" FontSize="16" TextColor="#2E7D32" FontAttributes="Bold"/>
                <Entry x:Name="JobTitleEntry" 
                       Placeholder="npr. Frontend Developer" 
                       BackgroundColor="#F5F5F5" 
                       TextColor="Black"
                       HeightRequest="50"/>
            </StackLayout>

            <!-- Kategorija -->
            <StackLayout>
                <Label Text="Kategorija *" FontSize="16" TextColor="#2E7D32" FontAttributes="Bold"/>
                <Picker x:Name="CategoryPicker" 
                        BackgroundColor="#F5F5F5" 
                        TextColor="Black"
                        HeightRequest="50">
                    <Picker.Items>
                        <x:String>IT i tehnologija</x:String>
                        <x:String>Marketing i prodaja</x:String>
                        <x:String>Finansije i računovodstvo</x:String>
                        <x:String>Ljudski resursi</x:String>
                        <x:String>Dizajn i kreativnost</x:String>
                        <x:String>Proizvodnja</x:String>
                        <x:String>Obrazovanje</x:String>
                        <x:String>Zdravstvo</x:String>
                        <x:String>Usluge</x:String>
                        <x:String>Ostalo</x:String>
                    </Picker.Items>
                </Picker>
            </StackLayout>

            <!-- Lokacija -->
            <StackLayout>
                <Label Text="Lokacija *" FontSize="16" TextColor="#2E7D32" FontAttributes="Bold"/>
                <Entry x:Name="LocationEntry" 
                       Placeholder="npr. Sarajevo, BiH" 
                       BackgroundColor="#F5F5F5" 
                       TextColor="Black"
                       HeightRequest="50"/>
            </StackLayout>

            <!-- Tip posla -->
            <StackLayout>
                <Label Text="Tip posla *" FontSize="16" TextColor="#2E7D32" FontAttributes="Bold"/>
                <Picker x:Name="JobTypePicker" 
                        BackgroundColor="#F5F5F5" 
                        TextColor="Black"
                        HeightRequest="50">
                    <Picker.Items>
                        <x:String>Puno radno vrijeme</x:String>
                        <x:String>Povremeno</x:String>
                        <x:String>Ugovor</x:String>
                        <x:String>Stažiranje</x:String>
                        <x:String>Remote</x:String>
                    </Picker.Items>
                </Picker>
            </StackLayout>

            <!-- Plata -->
            <StackLayout>
                <Label Text="Plata (BAM) *" FontSize="16" TextColor="#2E7D32" FontAttributes="Bold"/>
                <StackLayout Orientation="Horizontal" Spacing="10">
                    <Entry x:Name="SalaryMinEntry" 
                           Placeholder="Od" 
                           Keyboard="Numeric"
                           BackgroundColor="#F5F5F5" 
                           TextColor="Black"
                           HeightRequest="50"
                           HorizontalOptions="FillAndExpand"/>
                    <Label Text="-" VerticalOptions="Center" FontSize="18" TextColor="#2E7D32"/>
                    <Entry x:Name="SalaryMaxEntry" 
                           Placeholder="Do" 
                           Keyboard="Numeric"
                           BackgroundColor="#F5F5F5" 
                           TextColor="Black"
                           HeightRequest="50"
                           HorizontalOptions="FillAndExpand"/>
                </StackLayout>
            </StackLayout>

            <!-- Opis posla -->
            <StackLayout>
                <Label Text="Opis posla *" FontSize="16" TextColor="#2E7D32" FontAttributes="Bold"/>
                <Editor x:Name="JobDescriptionEditor" 
                        Placeholder="Opišite poziciju, odgovornosti, zahtjeve..."
                        BackgroundColor="#F5F5F5" 
                        TextColor="Black"
                        HeightRequest="120"/>
            </StackLayout>

            <!-- Zahtjevi -->
            <StackLayout>
                <Label Text="Zahtjevi i kvalifikacije" FontSize="16" TextColor="#2E7D32" FontAttributes="Bold"/>
                <Editor x:Name="RequirementsEditor" 
                        Placeholder="Obrazovanje, iskustvo, vještine..."
                        BackgroundColor="#F5F5F5" 
                        TextColor="Black"
                        HeightRequest="100"/>
            </StackLayout>

            <!-- Benefiti -->
            <StackLayout>
                <Label Text="Benefiti i pogodnosti" FontSize="16" TextColor="#2E7D32" FontAttributes="Bold"/>
                <Editor x:Name="BenefitsEditor" 
                        Placeholder="Zdravstveno osiguranje, bonusi, fleksibilno radno vrijeme..."
                        BackgroundColor="#F5F5F5" 
                        TextColor="Black"
                        HeightRequest="100"/>
            </StackLayout>

            <!-- Dugmad -->
            <StackLayout Spacing="10" Margin="0,20,0,0">
                <Button x:Name="PublishJobButton"
                        Text="OBJAVI POSAO"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        CornerRadius="25"
                        Clicked="OnPublishJobClicked"/>

                <Button x:Name="SaveDraftButton"
                        Text="IZBRIŠI POSAO"
                        BackgroundColor="#4CAF50"
                        TextColor="Transparent"
                        FontSize="14"
                        HeightRequest="45"
                        BorderColor="#4CAF50"
                        BorderWidth="1"
                        CornerRadius="22"
                        Clicked="OnSaveDraftClicked"/>
            </StackLayout>

        </StackLayout>
    </ScrollView>
</ContentPage>