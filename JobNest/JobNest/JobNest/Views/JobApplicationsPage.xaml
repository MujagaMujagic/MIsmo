<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="JobNest.Views.JobApplicationsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F8F9FA"
             Title="Aplikacije">

    <ContentPage.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="ApplicationTemplate">
                <Grid Padding="0,5">
                    <Frame BackgroundColor="White" CornerRadius="10" Padding="20" HasShadow="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Candidate Name -->
                            <Label Grid.Row="0" 
                                   Text="{Binding CandidateName}" 
                                   FontSize="18" 
                                   FontAttributes="Bold" 
                                   TextColor="Black"/>

                            <!-- Contact Info -->
                            <Grid Grid.Row="1" Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackLayout Grid.Column="0" Orientation="Horizontal">
                                    <Label Text="📧" FontSize="14"/>
                                    <Label Text="{Binding CandidateEmail}" FontSize="12" TextColor="Gray"/>
                                </StackLayout>

                                <StackLayout Grid.Column="1" Orientation="Horizontal" HorizontalOptions="End">
                                    <Label Text="📱" FontSize="14"/>
                                    <Label Text="{Binding CandidatePhone}" FontSize="12" TextColor="Gray"/>
                                </StackLayout>
                            </Grid>

                            <!-- Applied Date -->
                            <Label Grid.Row="2" 
                                   Text="{Binding AppliedDate, StringFormat='Prijavljeno: {0:dd.MM.yyyy HH:mm}'}" 
                                   FontSize="12" 
                                   TextColor="Gray" 
                                   Margin="0,5"/>

                            <!-- Status Badge -->
                            <Grid Grid.Row="3" Margin="0,10,0,0">
                                <Frame BackgroundColor="#E8F5E8" 
                                       CornerRadius="15" 
                                       Padding="10,5" 
                                       HorizontalOptions="Start">
                                    <Label Text="{Binding Status}" 
                                           FontSize="12" 
                                           TextColor="#1B5E20"
                                           FontAttributes="Bold"/>
                                </Frame>
                            </Grid>
                        </Grid>
                    </Frame>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" BackgroundColor="#1B5E20" Padding="20,50,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" 
                    Text="←" 
                    BackgroundColor="Transparent" 
                    TextColor="White" 
                    FontSize="24" 
                    WidthRequest="50"
                    Clicked="OnBackClicked"/>

            <StackLayout Grid.Column="1" VerticalOptions="Center">
                <Label x:Name="JobTitleLabel"
                       Text="Naziv posla" 
                       FontSize="20" 
                       FontAttributes="Bold"
                       TextColor="White"/>
                <Label x:Name="ApplicationCountLabel"
                       Text="0 aplikacija"
                       FontSize="14" 
                       TextColor="White" 
                       Opacity="0.8"/>
            </StackLayout>
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1" Padding="20">
            <StackLayout Spacing="15">
                <!-- Applications List -->
                <CollectionView x:Name="ApplicationsCollectionView"
                                ItemTemplate="{StaticResource ApplicationTemplate}"/>

                <!-- Empty State -->
                <StackLayout x:Name="EmptyStateLayout" 
                             IsVisible="False" 
                             VerticalOptions="Center" 
                             HorizontalOptions="Center"
                             Spacing="20"
                             Margin="0,100,0,0">
                    <Label Text="📭" FontSize="60" HorizontalOptions="Center"/>
                    <Label Text="Nema aplikacija za ovaj posao" 
                           FontSize="18" 
                           TextColor="Gray" 
                           HorizontalOptions="Center"/>
                    <Label Text="Kada se kandidati prijave, vidjeće se ovdje." 
                           FontSize="14" 
                           TextColor="Gray" 
                           HorizontalOptions="Center"/>
                </StackLayout>

            </StackLayout>
        </ScrollView>

    </Grid>
</ContentPage>